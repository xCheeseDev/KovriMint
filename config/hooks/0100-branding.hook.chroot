#!/bin/sh
# KovriMint branding — runs inside the chroot during the build.
set -e

echo "kovrimint" > /etc/hostname
sed -i 's/127\.0\.1\.1.*/127.0.1.1\tkovrimint/' /etc/hosts || \
    echo "127.0.1.1	kovrimint" >> /etc/hosts

cat > /etc/os-release <<'EOF'
PRETTY_NAME="KovriMint 1.0"
NAME="KovriMint"
VERSION="1.0"
VERSION_ID="1.0"
ID=kovrimint
ID_LIKE=debian
HOME_URL="https://github.com/xCheeseDev/KovriMint"
SUPPORT_URL="https://github.com/xCheeseDev/KovriMint/issues"
BUG_REPORT_URL="https://github.com/xCheeseDev/KovriMint/issues"
EOF

cp /etc/os-release /usr/lib/os-release 2>/dev/null || true

cat > /etc/issue <<'EOF'
KovriMint 1.0 — amnesic Monero live environment
https://github.com/xCheeseDev/KovriMint
EOF
